{
  "name": "@neuraiproject/neurai-depin-msg",
  "version": "2.3.0",
  "description": "Build, receive, validate and decrypt DePIN encrypted messages for Neurai blockchain",
  "type": "module",
  "main": "dist/neurai-depin-msg.cjs",
  "module": "dist/neurai-depin-msg.mjs",
  "browser": "dist/neurai-depin-msg.min.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/neurai-depin-msg.mjs",
      "require": "./dist/neurai-depin-msg.cjs",
      "default": "./dist/neurai-depin-msg.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "build": "npm run build:iife && npm run build:iife:dev && npm run build:esm && npm run build:cjs",
    "build:iife": "esbuild src/index.js --bundle --minify --format=iife --global-name=neuraiDepinMsg --outfile=dist/neurai-depin-msg.min.js",
    "build:iife:dev": "esbuild src/index.js --bundle --format=iife --global-name=neuraiDepinMsg --outfile=dist/neurai-depin-msg.js",
    "build:esm": "esbuild src/index.js --bundle --format=esm --packages=external --outfile=dist/neurai-depin-msg.mjs",
    "build:cjs": "esbuild src/index.js --bundle --format=cjs --packages=external --outfile=dist/neurai-depin-msg.cjs",
    "test": "node --test 'test/*.test.mjs'",
    "gen-fixtures": "node scripts/generate-fixtures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-depin-msg.git"
  },
  "keywords": [
    "Neurai",
    "XNA",
    "DePIN",
    "ECIES",
    "encryption",
    "messaging"
  ],
  "author": "Neuraiproject",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neuraiproject/neurai-depin-msg/issues"
  },
  "homepage": "https://github.com/neuraiproject/neurai-depin-msg#readme",
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
